          "type": "nominal",
          "sort": [
            "HW Bush",
            "W Bush",
            "Obama",
            "Clinton",
            "Trump",
            "Reagan"
          ]
        },
        "x": {
          "field": "approval",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 50
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "color": "#333333",
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
