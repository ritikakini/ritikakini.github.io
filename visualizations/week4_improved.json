  "title": {
    "text": "Trump's approval after two years was the joint lowest of these presidents",
    "subtitle": [
      "Presidential job approval rating after two years in office.",
      "Dashed line marks 50% (majority approval)."
    ],
    "anchor": "start",
    "frame": "bounds",
    "font": "Helvetica, Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#444444",
    "subtitlePadding": 6,
    "offset": 14
  },
  "data": {
    "values": [
      {
        "president": "Trump",
        "approval": 37,
        "party": "Republican"
      },
      {
        "president": "Obama",
        "approval": 50,
        "party": "Democrat"
      },
      {
        "president": "W Bush",
        "approval": 58,
        "party": "Republican"
      },
      {
        "president": "Clinton",
        "approval": 47,
        "party": "Democrat"
      },
      {
        "president": "HW Bush",
        "approval": 64,
        "party": "Republican"
      },
      {
        "president": "Reagan",
        "approval": 37,
        "party": "Republican"
      }
    ]
  },
  "transform": [
    {
      "calculate": "datum.approval + '%'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "president",
          "type": "nominal",
          "sort": [
            "HW Bush",
            "W Bush",
            "Obama",
            "Clinton",
            "Trump",
            "Reagan"
          ],
          "axis": {
            "title": null,
            "ticks": false,
            "domainColor": "#222222",
            "domainWidth": 1.5,
            "labelFontSize": 14,
            "labelColor": "#222222",
            "labelFont": "Helvetica, Arial, sans-serif",
            "labelPadding": 10
          },
          "scale": {
            "paddingInner": 0.15,
            "paddingOuter": 0.1
          }
        },
        "x": {
          "field": "approval",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              70
            ]
          },
          "axis": {
            "title": "Job approval (%)",
            "titleFont": "Helvetica, Arial, sans-serif",
            "titleColor": "#444444",
            "labelFont": "Helvetica, Arial, sans-serif",
            "labelColor": "#444444",
            "values": [
              0,
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ],
            "grid": false,
            "domain": false,
            "tickColor": "#bbbbbb"
          }
        },
        "color": {
          "field": "party",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Republican",
              "Democrat"
            ],
            "range": [
              "#bb3127",
              "#2e69a4"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "labelFont": "Helvetica, Arial, sans-serif",
            "labelFontSize": 13,
            "symbolType": "square",
            "offset": 4
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "color": "#ffffff",
        "fontSize": 14,
        "font": "Helvetica, Arial, sans-serif",
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
