{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": 520,
  "height": 320,
  "padding": {
    "left": 15,
    "right": 20,
    "top": 15,
    "bottom": 15
