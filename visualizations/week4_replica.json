{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#ffffff",
  "width": 520,
  "height": 330,
  "padding": {
    "left": 15,
    "right": 20,
    "top": 15,
    "bottom": 15
  },
  "title": {
    "text": "How does Trump's support compare?",
    "subtitle": "Presidential job approval rating after two years in office",
    "anchor": "start",
    "frame": "bounds",
    "font": "Helvetica, Arial, sans-serif",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleFontSize": 18,
    "subtitleColor": "#222222",
    "subtitlePadding": 6,
    "offset": 16
  },
  "data": {
    "values": [
      {
        "president": "Trump",
        "approval": 37,
        "party": "Republican"
      },
      {
        "president": "Obama",
        "approval": 50,
        "party": "Democrat"
      },
      {
        "president": "W Bush",
        "approval": 58,
        "party": "Republican"
      },
      {
        "president": "Clinton",
        "approval": 47,
        "party": "Democrat"
      },
      {
        "president": "HW Bush",
        "approval": 64,
        "party": "Republican"
      },
      {
        "president": "Reagan",
        "approval": 37,
        "party": "Republican"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "president",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "ticks": false,
            "domainColor": "#222222",
            "domainWidth": 2,
            "labelFontSize": 15,
            "labelColor": "#222222",
            "labelFont": "Helvetica, Arial, sans-serif",
            "labelPadding": 12
          },
          "scale": {
            "paddingInner": 0.1,
            "paddingOuter": 0.15
          }
        },
        "x": {
          "field": "approval",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              65
            ]
          }
        },
        "color": {
          "field": "party",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Republican",
              "Democrat"
            ],
            "range": [
              "#bb3127",
              "#2e69a4"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "color": "#ffffff",
        "fontSize": 15,
        "font": "Helvetica, Arial, sans-serif"
      },
      "encoding": {
        "y": {
          "field": "president",
          "type": "nominal",
          "sort": null
        },
        "x": {
          "field": "approval",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "tooltip": {
          "value": null
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#555555",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": -110
        },
        "x2": {
          "value": 530
        },
        "y": {
          "value": 344
        },
        "y2": {
          "value": 344
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "color": "#222222",
        "font": "Helvetica, Arial, sans-serif",
        "text": "Source: Gallup"
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "y": {
          "value": 352
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "calculate": "datum.approval + '%'",
      "as": "label"
    }
  ]
}
